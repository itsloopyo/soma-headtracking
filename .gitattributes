* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# The config differential test's inputs and its verbatim copies of published
# sources are compared byte for byte, so git must not touch their line endings.
tests/config_differential/data/** -text
tests/config_differential/oracle/** -text

# The committed copy of the CameraUnlock.ini the mod creates; its render test compares it byte
# for byte, CRLF included.
config/CameraUnlock.ini -text
